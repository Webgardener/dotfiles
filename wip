ENV           ?= local
KUBE_CONTEXT   = k3d-dmzrasc
CHARTS_DIR     = helm/charts
VALUES_DIR     = helm/values
NAMESPACES     = green blue tools data managed-services
REGISTRY_SECRET_FILE = <chemin>/docker-itg.yaml
CLUSTER_NAME   = dmzrasc

# ==============================================================================
# Help (défaut)
# ==============================================================================
.DEFAULT_GOAL := help

help:
	@echo ""
	@echo "Usage: make <target> [ENV=local|staging|prod]"
	@echo ""
	@echo "Targets principaux:"
	@echo "  init                  Bootstrap complet (idempotent)"
	@echo "  init SCRATCH=true     Tout supprimer puis recréer"
	@echo ""
	@echo "Cluster:"
	@echo "  create-cluster        Créer le cluster k3d"
	@echo "  delete-cluster        Supprimer le cluster k3d"
	@echo "  create-namespaces     Créer les namespaces"
	@echo ""
	@echo "Registry:"
	@echo "  create-registry-secrets  Pousser le secret Artifactory (local uniquement)"
	@echo ""
	@echo "Deploy:"
	@echo "  deploy-vault          Déployer Vault (local uniquement)"
	@echo "  deploy-postgres       Déployer PostgreSQL (local uniquement)"
	@echo "  deploy-keycloak       Déployer Keycloak"
	@echo "  deploy-all            Déployer tous les composants"
	@echo ""
	@echo "Terraform:"
	@echo "  tf-apply              Appliquer Terraform"
	@echo "  tf-destroy            Détruire Terraform"
	@echo ""
	@echo "Utilitaires:"
	@echo "  port-forward          Port-forward Vault (local uniquement)"
	@echo "  status                État des pods par namespace"
	@echo ""

# ==============================================================================
# Helpers
# ==============================================================================
define helm_apply
	helm template $(1) $(CHARTS_DIR)/$(1) \
		--namespace $(2) \
		-f $(VALUES_DIR)/$(ENV)/$(1).yaml \
	| kubectl --context=$(KUBE_CONTEXT) apply -f -
endef

define helm_delete
	helm template $(1) $(CHARTS_DIR)/$(1) \
		--namespace $(2) \
		-f $(VALUES_DIR)/$(ENV)/$(1).yaml \
	| kubectl --context=$(KUBE_CONTEXT) delete --ignore-not-found -f -
endef

# ==============================================================================
# Init
# ==============================================================================
.PHONY: init

init:
ifdef SCRATCH
	@echo ">>> Mode from-scratch: suppression du cluster..."
	$(MAKE) delete-cluster
endif
	@echo ">>> Bootstrap dmzrasc [ENV=$(ENV)]"
	$(MAKE) create-cluster
	$(MAKE) create-namespaces
	$(MAKE) create-registry-secrets
	$(MAKE) deploy-vault
	$(MAKE) port-forward
	$(MAKE) tf-apply
	$(MAKE) deploy-postgres
	$(MAKE) deploy-keycloak
	@echo ">>> dmzrasc prêt !"

# ==============================================================================
# Cluster
# ==============================================================================
.PHONY: create-cluster delete-cluster create-namespaces

create-cluster:
	@if k3d cluster list | grep -q $(CLUSTER_NAME); then \
		echo "Cluster $(CLUSTER_NAME) déjà existant — skip"; \
	else \
		echo "Création du cluster $(CLUSTER_NAME)..."; \
		envsubst < registries.yaml.tpl > /tmp/registries.yaml; \
		k3d cluster create $(CLUSTER_NAME) \
			--servers 1 \
			--agents 2 \
			--k3s-arg "--disable=traefik@server:0" \
			--registry-config /tmp/registries.yaml; \
		rm /tmp/registries.yaml; \
	fi

delete-cluster:
	@if k3d cluster list | grep -q $(CLUSTER_NAME); then \
		echo "Suppression du cluster $(CLUSTER_NAME)..."; \
		k3d cluster delete $(CLUSTER_NAME); \
	else \
		echo "Cluster $(CLUSTER_NAME) inexistant — skip"; \
	fi

create-namespaces:
	@for ns in $(NAMESPACES); do \
		kubectl --context=$(KUBE_CONTEXT) create namespace $$ns \
			--dry-run=client -o yaml \
		| kubectl --context=$(KUBE_CONTEXT) apply -f -; \
	done

# ==============================================================================
# Registry secrets (local uniquement)
# ==============================================================================
.PHONY: create-registry-secrets

create-registry-secrets:
ifeq ($(ENV),local)
	@for ns in $(NAMESPACES); do \
		echo "Registry secret → $$ns"; \
		envsubst < $(REGISTRY_SECRET_FILE) \
		| kubectl --context=$(KUBE_CONTEXT) apply -n $$ns -f -; \
	done
else
	@echo "Skipping registry secrets — managed by IBM Cloud in $(ENV)"
endif

# ==============================================================================
# Deploy
# ==============================================================================
.PHONY: deploy-vault deploy-postgres deploy-keycloak deploy-all

deploy-vault:
ifeq ($(ENV),local)
	@echo "Deploying Vault..."
	@$(call helm_apply,vault,managed-services)
else
	@echo "Skipping Vault — managed service in $(ENV)"
endif

deploy-postgres:
ifeq ($(ENV),local)
	@echo "Deploying PostgreSQL..."
	@$(call helm_apply,postgres,managed-services)
else
	@echo "Skipping PostgreSQL — managed service in $(ENV)"
endif

deploy-keycloak:
	@echo "Deploying Keycloak..."
	@$(call helm_apply,keycloak,green)

deploy-all: deploy-vault deploy-postgres deploy-keycloak

# ==============================================================================
# Port-forward (local uniquement)
# ==============================================================================
.PHONY: port-forward

port-forward:
ifeq ($(ENV),local)
	@echo "Waiting for Vault to be ready..."
	kubectl --context=$(KUBE_CONTEXT) wait pod \
		-n managed-services \
		-l app=vault \
		--for=condition=Ready \
		--timeout=120s
	kubectl --context=$(KUBE_CONTEXT) port-forward \
		-n managed-services svc/vault 8200:8200 \
		>/dev/null 2>&1 &
	@echo "Vault UI → http://localhost:8200"
else
	@echo "Skipping port-forward — not needed in $(ENV)"
endif

# ==============================================================================
# Terraform
# ==============================================================================
.PHONY: tf-apply tf-destroy

tf-apply:
	bash -c "source infra-variables.sh && export_$(ENV) && \
	export VAULT_ADDR=http://localhost:8200 && \
	export VAULT_TOKEN=$$VAULT_TOKEN && \
	cd terraform/$(ENV) && terraform init && terraform apply -auto-approve"

tf-destroy:
	bash -c "source infra-variables.sh && export_$(ENV) && \
	export VAULT_ADDR=http://localhost:8200 && \
	export VAULT_TOKEN=$$VAULT_TOKEN && \
	cd terraform/$(ENV) && terraform destroy -auto-approve"

# ==============================================================================
# Utilitaires
# ==============================================================================
.PHONY: status

status:
	@for ns in $(NAMESPACES); do \
		echo "\n--- $$ns ---"; \
		kubectl --context=$(KUBE_CONTEXT) get pods -n $$ns 2>/dev/null || true; \
	done
