vault:
  server:
    image:
      repository: <registry-privee>/<chemin>/vault
      tag: "1.17.0"        # version à adapter
      pullPolicy: IfNotPresent

    dev:
      enabled: false
    standalone:
      enabled: true
      config: |
        ui = true
        listener "tcp" {
          tls_disable = 1
          address     = "[::]:8200"
        }
        storage "file" {
          path = "/vault/data"
        }
    dataStorage:
      enabled: true
      size: 1Gi
      storageClass: local-path

  injector:
    enabled: true
    image:
      repository: <registry-privee>/<chemin>/vault-k8s   # image de l'injector
      tag: "0.17.0"

  ui:
    enabled: true
    serviceType: ClusterIP
