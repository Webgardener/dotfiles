#!/bin/bash
set -euo pipefail

# ─────────────────────────────────────────────
# Called by Makefile at project root
# Extracts k3d CA cert and writes it next to the terraform module
# ─────────────────────────────────────────────

CLUSTER_NAME="${CLUSTER_NAME:-}"
TF_MODULE_DIR="${TF_MODULE_DIR:-./infra/vault}"

if [[ -z "$CLUSTER_NAME" ]]; then
  echo "❌ Error: CLUSTER_NAME environment variable is required"
  exit 1
fi

if ! command -v k3d &>/dev/null; then
  echo "❌ Missing dependency: k3d"
  exit 1
fi

if [[ ! -d "$TF_MODULE_DIR" ]]; then
  echo "❌ Directory not found: $TF_MODULE_DIR"
  exit 1
fi

echo "🔍 Fetching kubeconfig for cluster: $CLUSTER_NAME"

KUBECONFIG_RAW=$(k3d kubeconfig get "$CLUSTER_NAME")

CA_CERT_B64=$(echo "$KUBECONFIG_RAW" | grep "certificate-authority-data" | awk '{print $2}' | tr -d '[:space:]')
if [[ -z "$CA_CERT_B64" ]]; then
  echo "❌ Could not find certificate-authority-data in kubeconfig"
  exit 1
fi

echo "$CA_CERT_B64" | base64 -d > "$TF_MODULE_DIR/ca.crt"

echo "✅ ca.crt saved → $TF_MODULE_DIR/ca.crt"
